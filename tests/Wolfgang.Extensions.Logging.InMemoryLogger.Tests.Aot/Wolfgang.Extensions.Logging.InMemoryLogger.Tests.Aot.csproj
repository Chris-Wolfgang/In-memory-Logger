<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native AOT test run (fleet AOT standard, 2026-10-30).

    Runs the SAME unit tests as Wolfgang.Extensions.Logging.InMemoryLogger.Tests.Unit, compiled
    as a Native AOT executable with xUnit v3. The 2.x project stays as it is for every TFM; this
    one exists only to prove the library under trimming + AOT, which a JIT test run cannot.

    The test sources are linked, not copied: fix a test in Tests.Unit and it is fixed here.
    xUnit v3's in-process console runner makes this project its own executable (no
    Microsoft.NET.Test.Sdk), and with PublishAot that executable is a native binary.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Follows Tests.Unit: the repo is multi-targeted, so the linked sources carry explicit usings. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Not a dotnet-test project: build-pr.ps1 runs `dotnet test` only on IsTestProject /
         Microsoft.NET.Test.Sdk projects. This one is published and executed by the AOT job. -->
    <IsTestProject>false</IsTestProject>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <IsAotCompatible>true</IsAotCompatible>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- No test uses a real culture, so ICU is not needed. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- The AOT (source-generated) edition of xUnit.net v3: test discovery, theory data and attribute
         configuration are resolved at build time, so no reflection is needed at run time. The plain
         `xunit.v3` package is reflection-based and cannot run under Native AOT. Requires net9.0+ and C#. -->
    <PackageReference Include="xunit.v3.aot" Version="4.0.2" />
    <!-- Same reference as Tests.Unit: InMemoryLoggerBuilderExtensionsTests builds a ServiceCollection. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Wolfgang.Extensions.Logging.InMemoryLogger\Wolfgang.Extensions.Logging.InMemoryLogger.csproj" />
  </ItemGroup>

  <!-- The unit tests themselves, linked from the 2.x project. -->
  <ItemGroup>
    <Compile Include="..\Wolfgang.Extensions.Logging.InMemoryLogger.Tests.Unit\**\*.cs" Exclude="..\Wolfgang.Extensions.Logging.InMemoryLogger.Tests.Unit\obj\**;..\Wolfgang.Extensions.Logging.InMemoryLogger.Tests.Unit\bin\**" Link="Unit\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
