<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net462;netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
		<Version>0.1.3</Version>
		<!-- Pin AssemblyVersion to a fixed binding-stability baseline so consumers
		     do not need to recompile / add binding redirects on every minor/patch
		     bump. Bump only on a deliberate breaking API change. FileVersion +
		     InformationalVersion (the latter auto-derived from <Version>) carry
		     the actual release version. -->
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>$([System.Text.RegularExpressions.Regex]::Replace("$(Version)", "[-+].*$", "")).0</FileVersion>
		<Title>$(AssemblyName)</Title>
		<Description>Implementations of ILogger and ILogger&lt;T&gt; that write log entries to an in-memory collection</Description>
		<PackageProjectUrl>https://github.com/Chris-Wolfgang/In-memory-Logger</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Chris-Wolfgang/In-memory-Logger.git</RepositoryUrl>
		<PackageTags>logging;ilogger;testing;in-memory;unit-testing;microsoft-extensions-logging</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<SignAssembly>False</SignAssembly>

		<!-- PackageValidation: pack fails if the package introduces a binary-breaking change
		     against the last published version (ApiCompat per target framework). Intentional
		     breaks are waived in CompatibilitySuppressions.xml with the specific rule ID and
		     target. Keep the baseline at the last published version and bump it in the release
		     PR that ships the next one. -->
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>0.1.3</PackageValidationBaselineVersion>
	</PropertyGroup>

	<!-- Trimming and Native AOT: the library uses no reflection, dynamic code or runtime code
	     generation, so it is annotated as safe for both. IsAotCompatible turns on the trim,
	     single-file and AOT analyzers, so a change that is not trim/AOT-safe fails the Release
	     build (warnings are errors). Only net8.0+ supports these properties; on net462 and
	     netstandard2.x they would only raise NETSDK1210. -->
	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<IsAotCompatible>true</IsAotCompatible>
		<IsTrimmable>true</IsTrimmable>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net462'">
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
